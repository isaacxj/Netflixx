# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored: it holds the VPN key.

# Your user and group on stx-server. Run `id` to check (usually 1000 and 1000).
PUID=1000
PGID=1000
TZ=America/Chicago

# Where the media drive is mounted. Downloads and the library both live under
# it, on the same drive, so imports are hardlinks instead of copies.
DATA_ROOT=/srv/data

# VPN for qBittorrent, as WireGuard. ProtonVPN: account.proton.me > VPN >
# WireGuard, tick NAT-PMP (Port Forwarding), pick a US P2P server, then copy
# PrivateKey and Address from the config it shows. Other providers' names:
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_PROVIDER=protonvpn
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=10.2.0.2/32
VPN_COUNTRIES="United States"
# ProtonVPN: torrents only on P2P servers, and an incoming port for more peers.
VPN_P2P_ONLY=on
VPN_PORT_FORWARDING=on

# This server's address on the home network, where AdGuard Home answers DNS.
LAN_IP=192.168.1.134

# For scripts/theme.sh: an admin API key from Jellyfin (Dashboard > API Keys > +).
JELLYFIN_API_KEY=
